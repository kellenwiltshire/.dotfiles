#!/usr/bin/env bash
set -euo pipefail

# The whole right-hand side of the tmux status bar, built in one fork per status-interval.
#
# CPU and network are cumulative counters, so a percentage or a rate only exists relative to a
# previous sample: everything needed to compute one is carried in $state between runs. Battery,
# disk and the choice of network interface move slowly and cost the most forks, so they refresh on
# their own timer and are replayed from $state in between.
#
# Segments drop out as the client narrows, so the clock is the last thing standing.

width=${1:-200}
host=${2:-}
slow_interval=30
os=$(uname -s)

# Night Owl, matched to the rest of tmux.conf.
c_label='#[fg=#5f7e97]'
c_value='#[fg=#8badc1]'
c_warn='#[fg=#f78c6c]'
c_crit='#[fg=#ef5350]'
c_edge='#[fg=#82aaff]'
c_badge='#[bg=#82aaff,fg=#011627,bold]'
c_reset='#[bg=default,fg=default]'

# U+E0B6 and U+E0B4, the half circles the window tabs use. They are Private Use Area codepoints,
# which some editors silently drop, so they are written as bytes rather than typed.
badge_left=$(printf '\xee\x82\xb6')
badge_right=$(printf '\xee\x82\xb4')

# A pipe separator, not a space: %p puts one inside the clock. %l is space-padded rather than
# zero-padded, which keeps the badge a constant width across the 9:59/10:00 boundary.
IFS='|' read -r now clock < <(date '+%s|%l:%M %p')

is_number() { [[ ${1:-} =~ ^[0-9]+$ ]]; }
is_number "$width" || width=200

# tmux keys a job by its command string, so clients of the same width share one run of this script
# and clients of different widths get their own. Keying the state file the same way stops those
# runs, and any manual invocation, from stealing each other's baseline.
state="${TMPDIR:-/tmp}/tmux-status.$UID.$width"

prev_ts=0 prev_busy=0 prev_total=0 prev_rx=0 prev_tx=0
slow_ts=0 iface=- batt=- disk=-
prev_cpu=- prev_rx_rate=- prev_tx_rate=-
if [[ -r $state ]]; then
  read -r prev_ts prev_busy prev_total prev_rx prev_tx slow_ts iface batt disk \
    prev_cpu prev_rx_rate prev_tx_rate <"$state" || true
fi

is_number "$prev_ts" || prev_ts=0
is_number "$prev_busy" || prev_busy=0
is_number "$prev_total" || prev_total=0
is_number "$prev_rx" || prev_rx=0
is_number "$prev_tx" || prev_tx=0
is_number "$slow_ts" || slow_ts=0

elapsed=$((now - prev_ts))
# A clock that went backwards, across a timezone change or an NTP correction, would otherwise
# leave the baseline stranded in the future and every rate frozen. Start again instead.
((elapsed >= 0)) || { prev_ts=0 prev_cpu=- prev_rx_rate=- prev_tx_rate=- elapsed=1; }

fmt_bytes() {
  local value=$1 unit=0 tenths=0
  local -a units=(B K M G T P)
  while ((value >= 1024 && unit < 5)); do
    tenths=$((value * 10 / 1024 % 10))
    value=$((value / 1024))
    unit=$((unit + 1))
  done
  if ((value < 10 && unit > 0)); then
    printf '%d.%d%s' "$value" "$tenths" "${units[unit]}"
  else
    printf '%d%s' "$value" "${units[unit]}"
  fi
}

tier() {
  local value=$1 warn=$2 crit=$3
  if ((value >= crit)); then
    printf '%s' "$c_crit"
  elif ((value >= warn)); then
    printf '%s' "$c_warn"
  else
    printf '%s' "$c_value"
  fi
}

segments=()
right_cols=0
add_segment() {
  segments+=("$c_label$1 $2$3")
  right_cols=$((right_cols + ${#1} + 1 + ${#3} + 2))
}

# A value that grows a digit would otherwise drag the clock sideways, since the clock is placed
# relative to this block. Every field is padded to its widest form to hold the width constant.
pad() { printf "%${2}s" "$1"; }

case $os in
  Darwin)
    { read -r ncpu; read -r mem_total; read -r _ load _; } < <(sysctl -n hw.ncpu hw.memsize vm.loadavg)

    # No /proc/stat here. Summing every process's cumulative CPU time gives the same kind of
    # monotonic counter, and its delta over the wall-clock delta across all cores is utilisation.
    # Processes that exit between samples take their share with them, so this reads slightly low
    # under heavy churn.
    busy=$(ps -A -o time= | awk -F: '
      { s += (NF == 3) ? $1 * 3600 + $2 * 60 + $3 : $1 * 60 + $2 }
      END { printf "%d", s }')
    total=0

    mem_used=$(vm_stat | awk '
      /page size of/ { page = $8 }
      /^Pages active/ { gsub(/\./, "", $3); active = $3 }
      /^Pages wired down/ { gsub(/\./, "", $4); wired = $4 }
      /^Pages occupied by compressor/ { gsub(/\./, "", $5); compressed = $5 }
      END { printf "%d", (active + wired + compressed) * page }')
    ;;
  *)
    ncpu=$(nproc)
    read -r load _ </proc/loadavg
    read -r _ user nice system idle iowait irq softirq steal _ </proc/stat
    total=$((user + nice + system + idle + iowait + irq + softirq + steal))
    busy=$((total - idle - iowait))

    # The newline is not decoration: `read` returns non-zero when the input ends without one, and
    # under `set -e` that kills the script even though both variables were assigned.
    read -r mem_total mem_used < <(awk '
      /^MemTotal:/ { total = $2 }
      /^MemAvailable:/ { available = $2 }
      END { printf "%d %d\n", total * 1024, (total - available) * 1024 }' /proc/meminfo)
    ;;
esac
is_number "${ncpu:-}" || ncpu=1

if ((now - slow_ts >= slow_interval)); then
  if [[ $os == Darwin ]]; then
    # The default route is usually a VPN tunnel, and tunnelled bytes are counted again on the
    # interface underneath, so pick the busiest physical link instead. Interfaces without a MAC
    # shift the columns, but the byte counters stay a fixed offset from the end.
    iface=$(netstat -ibn | awk '
      $3 ~ /^<Link/ && $1 !~ /^(lo|gif|stf|utun|awdl|llw|bridge|ap[0-9]|anpi|vmenet)/ {
        if ($(NF - 4) + $(NF - 1) > busiest) { busiest = $(NF - 4) + $(NF - 1); name = $1 }
      }
      END { print (name == "") ? "-" : name }')
    batt=$(pmset -g batt | awk '
      /InternalBattery/ {
        match($0, /[0-9]+%/)
        print substr($0, RSTART, RLENGTH - 1) (/discharging/ ? "-" : (/charged|AC attached/ ? "=" : "+"))
      }')
  else
    iface=-
    for supply in /sys/class/power_supply/BAT*; do
      [[ -r $supply/capacity && -r $supply/status ]] || continue
      case $(<"$supply/status") in
        Discharging) batt="$(<"$supply/capacity")-" ;;
        Charging) batt="$(<"$supply/capacity")+" ;;
        *) batt="$(<"$supply/capacity")=" ;;
      esac
      break
    done
  fi
  disk=$(df -Pk / | awk 'NR == 2 { printf "%d", $4 * 1024 }')
  slow_ts=$now
fi
[[ -n ${batt:-} ]] || batt=-

# Both reads are allowed to fail: an interface that has gone away produces no matching line, and
# an unguarded `read` returning non-zero would take the whole script down with it. The is_number
# guards below turn that into a zero rate rather than a blank status bar.
if [[ $os == Darwin && $iface != - ]]; then
  read -r rx tx < <(netstat -ibn -I "$iface" |
    awk '$3 ~ /^<Link/ { print $(NF - 4), $(NF - 1); exit }') || true
elif [[ -r /proc/net/dev ]]; then
  read -r rx tx < <(awk '
    NR > 2 {
      sub(/^[ \t]+/, "")
      split($0, halves, ":")
      if (halves[1] ~ /^(lo|utun|tun|tap|docker|veth|br-|virbr|vmnet|wg|tailscale)/) next
      split(halves[2], counters, " ")
      rx += counters[1]; tx += counters[9]
    }
    END { print rx + 0, tx + 0 }' /proc/net/dev) || true
fi
is_number "${rx:-}" || rx=0
is_number "${tx:-}" || tx=0

# Every rate needs two samples, and the first run after a reboot or a reload has only one. A
# second run inside the same second has two, but no interval to divide by: rather than show a
# gap, it repeats the last figures and leaves the older sample in place to measure against.
if ((prev_ts > 0 && elapsed > 0)); then
  if ((total > 0)); then
    delta=$((total - prev_total))
    cpu=$((delta > 0 ? (busy - prev_busy) * 100 / delta : 0))
  else
    cpu=$(((busy - prev_busy) * 100 / (elapsed * ncpu)))
  fi
  ((cpu >= 0)) || cpu=0
  ((cpu <= 100)) || cpu=100
  rx_rate=$((rx > prev_rx ? (rx - prev_rx) / elapsed : 0))
  tx_rate=$((tx > prev_tx ? (tx - prev_tx) / elapsed : 0))
else
  cpu=$prev_cpu rx_rate=$prev_rx_rate tx_rate=$prev_tx_rate
  is_number "$cpu" || cpu=-
  is_number "$rx_rate" || rx_rate=-
  is_number "$tx_rate" || tx_rate=-
fi

if ((elapsed > 0)); then
  printf '%d %d %d %d %d %d %s %s %s %s %s %s\n' \
    "$now" "$busy" "$total" "$rx" "$tx" "$slow_ts" "$iface" "$batt" "$disk" \
    "$cpu" "$rx_rate" "$tx_rate" >"$state"
else
  printf '%d %d %d %d %d %d %s %s %s %s %s %s\n' \
    "$prev_ts" "$prev_busy" "$prev_total" "$prev_rx" "$prev_tx" "$slow_ts" "$iface" "$batt" \
    "$disk" "$cpu" "$rx_rate" "$tx_rate" >"$state"
fi

if [[ $cpu == - ]]; then
  add_segment CPU "$c_value" "$(pad -- 4)"
  net="↓$(pad -- 5) ↑$(pad -- 5)"
else
  add_segment CPU "$(tier "$cpu" 60 85)" "$(pad "$cpu%" 4)"
  net="↓$(pad "$(fmt_bytes "$rx_rate")" 5) ↑$(pad "$(fmt_bytes "$tx_rate")" 5)"
fi

if ((width >= 150)); then
  # Not -v load=: gawk reserves that name for a builtin and dies, while BSD awk accepts it. The
  # same goes for anything else gawk calls its own, so keep these two deliberately unremarkable.
  load_pct=$(awk -v avg="$load" -v cores="$ncpu" 'BEGIN { printf "%d", avg * 100 / cores }')
  add_segment LOAD "$(tier "$load_pct" 70 100)" "$(pad "$load" 5)"
fi

if is_number "$mem_total" && ((mem_total > 0)); then
  mem_pct=$((mem_used * 100 / mem_total))
  add_segment MEM "$(tier "$mem_pct" 75 90)" "$(pad "$(fmt_bytes "$mem_used")" 4)/$(fmt_bytes "$mem_total")"
fi

if ((width >= 120)) && is_number "$disk"; then
  # Inverted thresholds: this is space left, so small is the bad end.
  disk_gb=$((disk / 1073741824))
  disk_colour=$c_value
  ((disk_gb >= 20)) || disk_colour=$c_warn
  ((disk_gb >= 10)) || disk_colour=$c_crit
  add_segment DSK "$disk_colour" "$(pad "$(fmt_bytes "$disk")" 4)"
fi

((width < 100)) || add_segment NET "$c_value" "$net"

if [[ $batt != - ]]; then
  charge=${batt%[-+=]}
  case ${batt: -1} in
    # Discharging is the only state worth colouring, and it inverts: low charge is the bad end.
    -) add_segment BAT "$(tier $((100 - charge)) 80 90)" "$(pad "$charge%" 4) " ;;
    +) add_segment BAT "$c_value" "$(pad "$charge%" 4)+" ;;
    *) add_segment BAT "$c_value" "$(pad "$charge%" 4)=" ;;
  esac
fi

right=''
if ((width >= 80 && ${#segments[@]} > 0)); then
  printf -v right '%s  ' "${segments[@]}"
fi
if ((width >= 110)) && [[ -n $host ]]; then
  right+="$c_label$host  "
  right_cols=$((right_cols + ${#host} + 2))
fi
# Segments are joined by two spaces; the last pair is the margin against the screen edge, and one
# column is enough for that.
right=${right%" "}
right_cols=$((right_cols - 1))

# absolute-centre pins the clock to the middle of the line no matter what surrounds it, which is
# what you want on a wide screen: plain centre splits the gap left over after the metrics, putting
# the clock well left of true centre. On a narrow client the metrics reach the middle and would be
# overwritten, so there it falls back to sharing the gap.
badge_cols=$((${#clock} + 4))
if (((width + badge_cols) / 2 < width - right_cols)); then
  c_centre='#[align=absolute-centre]'
else
  c_centre='#[align=centre]'
fi

printf '%s%s%s%s%s%s %s %s%s%s' \
  "$right" "$c_reset" "$c_centre" \
  "$c_edge" "$badge_left" \
  "$c_badge" "$clock" \
  "$c_reset" "$c_edge" "$badge_right"
