window-padding-x = 12
window-padding-y = 30,12
background-opacity = 0.95

# -----------------------------------------------------------------------------

# Font Configuration

# -----------------------------------------------------------------------------

# Values with spaces must be enclosed in quotes

font-size = 16

# -----------------------------------------------------------------------------

# Quake Mode Configuration

# -----------------------------------------------------------------------------

keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-animation-duration = 0.1

# Splits stay on cmd: ctrl+a/d/e/l/x are readline keys (bol, EOF, eol, clear,
# emacs prefix) and Ghostty consumes a bound key before the shell sees it.
# cmd+alt+hjkl is the vim twin of Ghostty's built-in cmd+alt+arrows.
# close_surface is left on its cmd+w default.
keybind = cmd+d=new_split:auto
keybind = cmd+alt+e=equalize_splits
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right

# -----------------------------------------------------------------------------

# Color Theme: Night Owl

# -----------------------------------------------------------------------------

theme = "Night Owl"

quick-terminal-size = 20%

# Slowdown mouse scrolling

mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)

async-backend = epoll
