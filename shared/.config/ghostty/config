window-padding-x = 12
window-padding-y = 30,12
background-opacity = 0.95

# -----------------------------------------------------------------------------

# Font Configuration

# -----------------------------------------------------------------------------

# Values with spaces must be enclosed in quotes

font-size = 16

# -----------------------------------------------------------------------------

# Quake Mode Configuration

# -----------------------------------------------------------------------------

keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-animation-duration = 0.1

# Splits stay on ctrl+shift, off both super and bare ctrl. Hyprland owns super on
# Omarchy and grabs it compositor-side (super+d, super+w) before Ghostty sees it,
# while ctrl+a/d/e/l/x are readline keys (bol, EOF, eol, clear, emacs prefix) that
# Ghostty would consume before the shell sees them.
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+e=equalize_splits
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# -----------------------------------------------------------------------------

# Color Theme: Night Owl

# -----------------------------------------------------------------------------

theme = "Night Owl"

quick-terminal-size = 20%

# Slowdown mouse scrolling

mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)

async-backend = epoll
