window-padding-x = 12
window-padding-y = 30,12
background-opacity = 0.95

# -----------------------------------------------------------------------------

# Font Configuration

# -----------------------------------------------------------------------------

# Values with spaces must be enclosed in quotes

font-size = 12

# -----------------------------------------------------------------------------

# Quake Mode Configuration

# -----------------------------------------------------------------------------

keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-animation-duration = 0.1

# Splits stay on ctrl+shift, off both super and bare ctrl. Hyprland owns super on
# Omarchy and grabs it compositor-side (super+w closes the window) before Ghostty
# sees it. Bare ctrl+a is the tmux prefix, and ctrl+d/e/l/x are readline keys (EOF,
# eol, clear, emacs prefix), all of which Ghostty must pass through untouched.
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+e=equalize_splits
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# -----------------------------------------------------------------------------

# Color Theme: Night Owl

# -----------------------------------------------------------------------------

theme = "Night Owl"

quick-terminal-size = 20%

# Slowdown mouse scrolling

mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)

async-backend = epoll

# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u

# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
