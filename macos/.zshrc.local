#Work Alias
alias homepage="cd ~/code/hs-app-home-page"
alias signup="cd ~/code/hs-app-signup"
alias fe-global="cd ~/code/fe-global"
alias dashboard="cd ~/code/dashboard"
alias website="cd ~/code/website"
alias c="cursor ."
alias master="gco master && gl && yarn"
alias yarn1="yarn set version 1.22.22"
alias yarn3="yarn set version 3.2.4"
alias yarn4="yarn set version 4.6.0"
alias rebase="gl --rebase"
alias start="yarn start"
alias test="yarn test"
