# macOS-only overrides on top of shared/.config/ghostty/config.

# Retina panels need 4pt more than the Omarchy laptop to match apparent size.
font-size = 16

# Ghostty only defaults option-to-alt on U.S. Standard / U.S. International layouts; on
# Canadian it composes Unicode instead, so alt+1..9 never reach tmux as M-1..M-9. Arrow and
# other non-printable Option combos were unaffected, which is why M-Left/M-Right already worked.
macos-option-as-alt = true
